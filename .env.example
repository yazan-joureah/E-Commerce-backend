CORS_ORIGIN=*

# MongoDB Connection
DB_STR=mongodb://admin:password@localhost:27017/

# For Docker containers (internal networking)
DB_STR_DOCKER=mongodb://admin:password@mongodb:27017/

# Database Name
DB_NAME=ecommerce

# App Config
PORT=3000
NODE_ENV=development

BASE_URL=http://localhost:3000/

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXP=60m

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - CRITICAL
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/oauth/google/callback

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080
APP_NAME=E-Commerce

# MFA
MFA_ENABLED=true
MFA_BACKUP_CODE_COUNT=10
TMP_JWT_EXP=5m

# Email Configuration (SMTP)
# SMTP server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication username (usually your email address)
SMTP_USER=yazanzzxzz@gmail.com

# SMTP authentication password (or app-specific password)
SMTP_PASS=xzli ovwx dbny yhws

# Sender email address for outgoing emails
EMAIL_FROM=yazanzzxzz@gmail.com

# Use TLS/SSL for SMTP connection (true or false)
SMTP_SECURE=false

# Base URL for password reset links (frontend URL)
RESET_URL_BASE=http://localhost:8080/reset-password
